{
  "name": "electrobun-vanilla-rpc",
  "version": "1.0.0",
  "type": "module",
  "description": "Basic Electrobun app with vanilla TypeScript and a generic RPC method",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary"
  },
  "dependencies": {
    "electrobun": "1.18.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.184.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
