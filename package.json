{
  "name": "clide",
  "version": "1.0.0",
  "description": "CLIDE — Command Line Integration Development Environment",
  "private": true,
  "author": "Kevin Lint <Lint Trap Media>",
  "license": "UNLICENSED",
  "copyright": "Copyright (c) 2026 Kevin Lint and Lint Trap Media. All Rights Reserved.",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "gen:site": "bun run scripts/gen-site.ts",
    "site": "open docs/index.html"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
